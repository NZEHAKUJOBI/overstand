# ─── Django core ──────────────────────────────────────────────────────────────
DJANGO_ENV=dev
DEBUG=True
SECRET_KEY=django-insecure-replace-this-with-a-real-50-char-random-string
ALLOWED_HOSTS=127.0.0.1,localhost

# ─── Database ─────────────────────────────────────────────────────────────────
# SQLite — simplest, no install needed. Good for local dev.
DATABASE_URL=sqlite:///db.sqlite3

# PostgreSQL — matches production. Uncomment if you have Postgres installed.
# DATABASE_URL=postgres://postgres:password@localhost:5432/ipawas_local

# ─── Cache / Redis ────────────────────────────────────────────────────────────
# Leave blank → falls back to in-memory cache (fine for local dev).
# Uncomment if you have Redis running locally.
# REDIS_URL=redis://localhost:6379/1

# ─── Cloudinary (file/image uploads) ─────────────────────────────────────────
# Leave blank locally — file uploads fail gracefully but all pages still load.
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret

# ─── Email ────────────────────────────────────────────────────────────────────
# Dev settings.py uses console backend — emails print to terminal, no SMTP needed.
CONTACT_EMAIL=infodesk@ipawas.org

# ─── Paystack (optional locally) ──────────────────────────────────────────────
# PAYSTACK_PUBLIC_KEY=pk_test_...
# PAYSTACK_SECRET_KEY=sk_test_...
