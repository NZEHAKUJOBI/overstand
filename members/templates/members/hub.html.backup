{% block extra_js %}
<script>
    function toggleView(mode) {
        const form = document.getElementById('filterForm');
        const input = form.querySelector('input[name="view"]');
        input.value = mode;
        form.submit();
    }

    // Animate stats on scroll
    const observerOptions = {
        threshold: 0.5,
        rootMargin: '0px'
    };

    const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
            if (entry.isIntersecting) {
                animateValue(entry.target);
                observer.unobserve(entry.target);
            }
        });
    }, observerOptions);

    document.querySelectorAll('.stat-number[data-count]').forEach(el => {
        observer.observe(el);
    });

    function animateValue(element) {
        const target = parseInt(element.getAttribute('data-count'));
        const duration = 2000;
        const increment = target / (duration / 16);
        let current = 0;

        const timer = setInterval(() => {
            current += increment;
            if (current >= target) {
                element.textContent = formatNumber(target);
                clearInterval(timer);
            } else {
                element.textContent = formatNumber(Math.floor(current));
            }
        }, 16);
    }

    function formatNumber(num) {
        if (num >= 1000000) {
            return (num / 1000000).toFixed(0) + 'M+';
        } else if (num >= 1000) {
            return (num / 1000).toFixed(0) + 'K+';
        }
        return num.toString();
    }
</script>
<!-- Load D3.js and TopoJSON libraries for accurate geodata -->
<script src="https://d3js.org/d3.v7.min.js"></script>
<script src="https://d3js.org/topojson.v3.min.js"></script>

<script>
    // Load accurate West Africa GeoJSON data and render map
    async function loadAccurateMap() {
        try {
            // Load world atlas TopoJSON data (from Natural Earth)
            const world = await d3.json('https://cdn.jsdelivr.net/npm/world-atlas@2/countries-110m.json');
            const countries = topojson.feature(world, world.objects.countries);

            // Load Cape Verde GeoJSON separately (Natural Earth)
            const capeVerdeGeo = await d3.json(
              '/static/geo/cape-verde.geojson'
            );
            console.log(capeVerdeGeo);

<!--            const capeVerdeGeo = await d3.json(-->
<!--              'https://raw.githubusercontent.com/datasets/geo-countries/master/data/countries/CV.geojson'-->
<!--            );-->

            // Manually inject Cape Verde (ISO numeric 132)
            const capeVerdeFeature = {
              type: "Feature",
              id: "132",
              properties: {
                name: "Cape Verde"
              },
              geometry: capeVerdeGeo.features[0].geometry
            };

            // Prevent duplicates (safety)
            const hasCapeVerde = countries.features.some(f => f.id === "132");
            if (!hasCapeVerde) {
              countries.features.push(capeVerdeFeature);
            }



            // West Africa country codes (ISO numeric)
            const westAfricaCodes = {
                '566': 'nigeria',
                '288': 'ghana',
                '686': 'senegal',
                '384': 'cote-divoire',
                '204': 'benin',
                '768': 'togo',
                '430': 'liberia',
                '694': 'sierra-leone',
                '324': 'guinea',
                '624': 'guinea-bissau',
                '270': 'gambia',
                '132': 'cabo-verde',
                '466': 'mali',           // Former member
                '854': 'burkina-faso',   // Former member
                '562': 'niger'           // Former member
            };

            // Debug: Log all countries to find Cape Verde
            console.log('Looking for Cape Verde/Cabo Verde with code 132...');


            // Filter West African countries
            const westAfricaCountries = countries.features.filter(d =>
                westAfricaCodes[d.id]
            );

            // Debug: Log found countries
            console.log('Found countries:', westAfricaCountries.map(d => ({
                id: d.id,
                mappedName: westAfricaCodes[d.id],
                properties: d.properties
            })));
            console.log(`Total countries found: ${westAfricaCountries.length}/15 expected`);

            // Specific check for Cape Verde
            const capeVerdeFound = westAfricaCountries.find(d => d.id === '132');
            if (capeVerdeFound) {
                console.log('✓ Cape Verde FOUND:', capeVerdeFound.properties);
            } else {
                console.log('✗ Cape Verde NOT FOUND - checking all countries with "verde" or "cabo"...');
                const allCountries = countries.features.filter(d => {
                    const name = d.properties?.name?.toLowerCase() || '';
                    return name.includes('verde') || name.includes('cabo') || name.includes('cape');
                });
                console.log('Countries with verde/cabo/cape:', allCountries.map(d => ({
                    id: d.id,
                    name: d.properties?.name
                })));
            }

            // Set up projection for West Africa
            const svg = d3.select("#west-africa-svg");
            const width = 960;
            const height = 700;

            // Geo projection optimized for West Africa - INCREASED SCALE FOR 80% COVERAGE

            const projection = d3.geoMercator()
                .center([-8, 13])
                .scale(1250)  // Increased from 800 to 1350 for larger map
                .translate([width / 2, height / 2]);

            const path = d3.geoPath().projection(projection);

            // Render countries
            const countriesGroup = d3.select("#countries-group");

            westAfricaCountries.forEach(feature => {
                const countryId = westAfricaCodes[feature.id];
                const isFormerMember = ['mali', 'burkina-faso', 'niger'].includes(countryId);

                // Add country path
                countriesGroup.append("path")
                    .attr("d", path(feature))
                    .attr("id", countryId)
                    .attr("class", isFormerMember ? "country-path former-member" : "country-path")
                    .attr("data-country", countryId)
                    .on("mouseenter", function(event) {
                        if (!isFormerMember) {
                            window.dispatchEvent(new CustomEvent('country-hover', {
                                detail: { country: countryId, event: event }
                            }));
                        }
                    })
                    .on("mouseleave", function() {
                        if (!isFormerMember) {
                            window.dispatchEvent(new CustomEvent('country-leave'));
                        }
                    })
                    .on("click", function() {
                        if (!isFormerMember) {
                            window.dispatchEvent(new CustomEvent('country-click', {
                                detail: { country: countryId }
                            }));
                        }
                    });

                // Add country label
                const centroid = path.centroid(feature);
                const countryNames = {
                    'nigeria': 'Nigeria',
                    'ghana': 'Ghana',
                    'senegal': 'Senegal',
                    'cote-divoire': "Côte d'Ivoire",
                    'benin': 'Benin',
                    'togo': 'Togo',
                    'liberia': 'Liberia',
                    'sierra-leone': 'S. Leone',
                    'guinea': 'Guinea',
                    'guinea-bissau': 'G-Bissau',
                    'gambia': 'Gambia',
                    'cabo-verde': 'Cabo Verde',
                    'mali': 'Mali',
                    'burkina-faso': 'Burkina Faso',
                    'niger': 'Niger'
                };

                countriesGroup.append("text")
                    .attr("x", centroid[0])
                    .attr("y", centroid[1])
                    .attr("class", isFormerMember ? "country-label former-member-label" : "country-label")
                    .attr("text-anchor", "middle")
                    .attr("font-size", countryId === 'nigeria' ? "20px" :
                                      countryId === 'cote-divoire' ? "16px" :
                                      ['gambia', 'guinea-bissau', 'togo'].includes(countryId) ? "13px" : "15px")
                    .text(countryNames[countryId] || countryId);
            });

            console.log("✓ Accurate map loaded with real GeoJSON boundaries");

        } catch (error) {
            console.error("Error loading map data:", error);
        }
    }

    // Alpine.js data component
    function mapInteraction() {
        return {
            selectedCountry: null,
            hoveredCountry: null,

            // Country data from database
            countryData: {{ country_data_json|safe }},

            init() {
                // Load accurate map on initialization
                loadAccurateMap();

                // Listen for custom events from D3
                window.addEventListener('country-hover', (e) => {
                    this.hoverCountry(e.detail.country, e.detail.event);
                });

                window.addEventListener('country-leave', () => {
                    this.clearHover();
                });

                window.addEventListener('country-click', (e) => {
                    this.selectCountry(e.detail.country);
                });
            },

            hoverCountry(country, event) {
                if (['mali', 'burkina-faso', 'niger'].includes(country)) {
                    return;
                }

                this.hoveredCountry = country;
                const countryInfo = this.countryData[country];

                if (countryInfo) {
                    const tooltip = document.getElementById('countryTooltip');
                    const tooltipFlag = document.getElementById('tooltipFlag');
                    const tooltipName = document.getElementById('tooltipName');

                    tooltipFlag.src = `https://flagcdn.com/w80/${countryInfo.code}.png`;
                    tooltipName.textContent = countryInfo.name;

                    tooltip.classList.add('show');
                    tooltip.style.left = (event.pageX + 15) + 'px';
                    tooltip.style.top = (event.pageY - 60) + 'px';
                }
            },

            clearHover() {
                this.hoveredCountry = null;
                const tooltip = document.getElementById('countryTooltip');
                tooltip.classList.remove('show');
            },

            selectCountry(country) {
                if (['mali', 'burkina-faso', 'niger'].includes(country)) {
                    return;
                }

                this.selectedCountry = country;

                // Remove active class from all countries
                document.querySelectorAll('.country-path').forEach(path => {
                    path.classList.remove('active');
                });

                // Add active class to selected country
                document.getElementById(country)?.classList.add('active');

                // Scroll to info panel on mobile
                if (window.innerWidth < 992) {
                    setTimeout(() => {
                        document.querySelector('.country-info-panel')?.scrollIntoView({
                            behavior: 'smooth',
                            block: 'nearest'
                        });
                    }, 100);
                }
            },

            getCountryInfo(country) {
                return this.countryData[country] || {};
            }
        }
    }

    // Update tooltip position on mouse move
    document.addEventListener('mousemove', function (e) {
        const tooltip = document.getElementById('countryTooltip');
        if (tooltip && tooltip.classList.contains('show')) {
            tooltip.style.left = (e.pageX + 15) + 'px';
            tooltip.style.top = (e.pageY - 60) + 'px';
        }
    });

    function statCounter() {
        return {
            count: 0,
            startCount() {
                let interval = setInterval(() => {
                    if (this.count < 350) {
                        this.count += 10;
                    } else {
                        clearInterval(interval);
                        this.count = 350;
                    }
                }, 50);
            }
        }
    }
</script>
{% endblock %}
